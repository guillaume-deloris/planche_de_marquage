<div class="results-container">
    <h1>{{game.name}} — Résultats</h1>

    <div class="winner-block">
        <h2>Vainqueur : {{winner.username}} !</h2>
        <p class="winner-score">{{winner.total}} points</p>
    </div>

    <table class="ranking-table">
        <thead>
            <tr>
                <th>Classement</th>
                <th>Joueur</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            {{#each ranking}}
            <tr class="{{#if @first}}winner-row{{/if}}">
                <td>{{add @index 1}}</td>
                <td>{{this.username}}</td>
                <td>{{this.total}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <a href="/dashboard">Retour au dashboard</a>
</div>

<script>
    {{#if @root.winner}}
    const winner = document.querySelector(".winner-block");
    winner.style.animation = "pulse 1s infinite";
    {{/if}}
</script>

<style>
    @keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }
</style>