<div class="game-view-container">

    <!-- HEADER -->
    <div class="game-header">
        <h1>{{game.name}}</h1>
        <button class="btn-icon" onclick="location.reload()" title="Actualiser la page">
            <i class="ti ti-refresh"></i>
        </button>
    </div>

    <!-- SECTION : tour en cours -->
    {{#if nextPlayerName}}
    <section class="game-section live-info">
        <div class="section-label">En cours</div>
        <div class="live-info__content">
            <div class="live-info__round">Tour {{currentRoundDisplay}}</div>
            <div class="live-info__player">{{nextPlayerName}}</div>
        </div>
    </section>
    {{/if}}

    <!-- SECTION : tableau des scores -->
    <section class="game-section">
        <div class="section-label">Scores</div>
        <table class="scores-table">
            <thead>
                <tr>
                    <th>Joueur</th>
                    {{#each scoreMap.[0].rounds}}
                    <th>T{{this.round}}</th>
                    {{/each}}
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                {{#each scoreMap}}
                <tr>
                    <td>{{this.username}}</td>
                    {{#each this.rounds}}
                    <td class="{{#if (eq this.round @root.currentRoundDisplay)}}{{#if (eq ../id @root.nextPlayerId)}}next-cell{{/if}}{{/if}}">
                        {{#if this.score}}{{this.score}}{{else}}-{{/if}}
                    </td>
                    {{/each}}
                    <td>{{this.total}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </section>

    <!-- ACTIONS -->
    <div class="game-actions">
        <button onclick="location.href='/dashboard'">Dashboard</button>
    </div>

</div>

<script>
    setTimeout(function() {
        location.reload();
    }, 60000);
</script>