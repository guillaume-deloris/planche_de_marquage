<div class="game-view-container">
    <h1>{{game.name}}</h1>
    {{#if nextPlayerName}}
    <p class="next-turn-info">Tour <strong>{{currentRoundDisplay}}</strong></p>
    <p class="next-turn-info">C'est à <strong>{{nextPlayerName}}</strong> de jouer</p>
    {{/if}}
    <table class="scores-table">
        <thead>
            <tr>
                <th>Joueur</th>
                {{#each scoreMap.[0].rounds}}
                <th>Tour {{this.round}}</th>
                {{/each}}
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            {{#each scoreMap}}
            <tr>
                <td>{{this.username}}</td>
                {{#each this.rounds}}
                <td class="{{#if (eq this.round @root.currentRoundDisplay)}}{{#if (eq ../id @root.nextPlayerId)}}next-cell{{/if}}{{/if}}">
                    {{#if this.score}}{{this.score}}{{else}}-{{/if}}
                </td>
                {{/each}}
                <td>{{this.total}}</td>
            </tr>
            {{/each}}
</tbody>
    </table>

    <button onclick="location.reload()">Actualiser</button>
</div>

<script>
    setTimeout(function() {
        location.reload();
    }, 60000);
</script>