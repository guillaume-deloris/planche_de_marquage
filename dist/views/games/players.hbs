<div class="game-players-container">

    <!-- HEADER -->
    <div class="game-header">
        <h1>{{game.name}}</h1>
        <button class="btn-icon" onclick="location.reload()" title="Actualiser la page">
            <i class="ti ti-refresh"></i>
        </button>
    </div>

    <!-- SECTION 1 : invitation -->
    <section class="game-section">
        <div class="section-label">Inviter des joueurs</div>
        <div class="qr-block">
            <img src="{{qrCode}}" alt="QR Code de la partie">
            <div class="qr-links">
                <p class="game-link">{{gameLink}}</p>
                <a href="https://wa.me/?text=Rejoins%20ma%20partie%20{{game.name}}%20:%20{{gameLink}}" target="_blank">
                    <button>Envoyer via WhatsApp</button>
                </a>
            </div>
        </div>
    </section>

    <!-- SECTION 2 : tour en cours -->
    {{#if nextPlayerName}}
    <section class="game-section live-info">
        <div class="section-label">En cours</div>
        <div class="live-info__content">
            <div class="live-info__round">Tour {{currentRoundDisplay}}</div>
            <div class="live-info__player">{{nextPlayerName}}</div>
        </div>
    </section>
    {{/if}}

    <!-- SECTION 3 : tableau des scores -->
    <section class="game-section">
        <div class="section-label">Scores</div>
        <table class="scores-table">
            <thead>
                <tr>
                    <th>Joueur</th>
                    {{#each scoreMap.[0].rounds}}
                    <th>T{{this.round}}</th>
                    {{/each}}
                    <th>Total</th>
                </tr>
            </thead>
            <tbody id="sortable-scores">
                {{#each scoreMap}}
                <tr data-player-id="{{this.id}}">
                    <td>{{this.username}}</td>
                    {{#each this.rounds}}
                    <td class="score-cell{{#if (eq this.round @root.currentRoundDisplay)}}{{#if (eq ../id @root.nextPlayerId)}} next-cell{{/if}}{{/if}}"
                        data-player-id="{{../id}}"
                        data-round="{{this.round}}">
                        {{#if this.score}}{{this.score}}{{else}}-{{/if}}
                    </td>
                    {{/each}}
                    <td class="total">{{this.total}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </section>

    <!-- ACTIONS -->
    <div class="game-actions">
        <form method="POST" action="/games/{{game.id}}/finish">
            <button type="submit" class="danger">Terminer la partie</button>
        </form>
        <button onclick="location.href='/dashboard'">Dashboard</button>
    </div>

    <!-- MODAL -->
    <div id="score-modal" style="display:none">
        <div class="modal-overlay"></div>
        <div class="modal-content">
            <div class="modal-header">
                <span id="modal-player-name"></span>
                <span class="modal-round">Tour <span id="modal-round"></span></span>
            </div>
            <input type="number" id="modal-score-input" placeholder="Score">
            <div class="modal-actions">
                <button id="modal-confirm" class="primary">Valider</button>
                <button id="modal-cancel">Annuler</button>
            </div>
        </div>
    </div>

</div>